# Скопируйте в .env.local. Секретов здесь нет: фронт никогда не ходит в ИИ напрямую.

# true (по умолчанию) — данные в браузере, бэкенд не нужен.
# false — настоящий бэкенд по VITE_API_URL.
VITE_USE_MOCKS=true

# Адрес бэкенда без /api. Пусто — тот же origin.
VITE_API_URL=http://localhost:8000

# false — ИИ-модуль Мерея подключён по-настоящему, плашку «Демо» у блоков ИИ можно снять.
# Пока ИИ на заглушке, оставьте true (раздел 8 спеки: честность демо).
VITE_AI_DEMO=true
