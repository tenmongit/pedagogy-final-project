# Скопируйте в .env на сервере. Файл .env в git не попадает.
ENV=production
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Ключ ИИ-провайдера. Только на сервере, во фронт не передаётся.
AI_API_KEY=
# openai — сервис Chat Completions по AI_BASE_URL; anthropic — Claude (AI_BASE_URL не нужен).
# Для Claude: AI_PROVIDER=anthropic, AI_MODEL=claude-opus-5-5, AI_MAX_TOKENS=4000
# (у Claude лимит включает размышления модели, 800 мало).
AI_PROVIDER=openai
# Базовый URL Chat Completions (обычно заканчивается на /v1).
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_MAX_TOKENS=800
AI_DAILY_LIMIT=100
# Опционально: путь к файлу счётчика. По умолчанию рядом с базой SQLite.
# AI_QUOTA_DB=/data/izden-ai-quota.db
# Только для Claude: глубина размышлений low | medium | high
AI_EFFORT=low
# Адрес фронта (через запятую, если несколько)
CORS_ORIGINS=http://localhost:5173
# 1 — создать демо-пользователей и задание на пустой базе
SEED_DEMO=1
